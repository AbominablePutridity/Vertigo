local factory = require "factory" --подключение компонента для создания обьекта

function init(self) --метод инициализации (при старте и один раз)
	msg.post(".", "acquire_input_focus")
	self.dir_x = 0 -- Запоминаем направление: -1 (влево), 1 (вправо), 0 (стоим)
	self.count_of_jump = 1

	-- НАШИ ПЕРЕМЕННЫЕ: угол и скорость вращения (в радианах)
	self.spawn_angle = 0
	self.spawn_rot_speed = 1 -- скорость движения (радиан в секунду)

	-- ОГРАНИЧЕНИЕ: переводим 45 градусов в радианы
	self.max_angle = math.rad(45) 

	-- Переменная для отслеживания стороны: 1 для право, -1 для лево
	self.look_dir = 1
end

function update(self, dt) --метод обновления (каждый кадр)
	go.set_rotation(vmath.quat(0, 0, 0, 1))  -- кватернион без поворота

	local v = go.get("#player_collider", "linear_velocity")

	-- Двигаем или останавливаем куб в зависимости от сохраненного направления
	v.x = self.dir_x * 300
	go.set("#player_collider", "linear_velocity", v)

	-- Сбрасываем направление для следующего кадра
	self.dir_x = 0

	-- СТРОКА ВРАЩЕНИЯ: увеличиваем угол
	self.spawn_angle = self.spawn_angle + self.spawn_rot_speed * dt

	-- ПРОВЕРКА ГРАНИЦ: если вышли за пределы от -45° до +45°
	if self.spawn_angle > self.max_angle then
		self.spawn_angle = self.max_angle       -- фиксируем на правой границе
		self.spawn_rot_speed = -self.spawn_rot_speed -- меняем направление вращения на обратное
	elseif self.spawn_angle < -self.max_angle then
		self.spawn_angle = -self.max_angle      -- фиксируем на левой границе
		self.spawn_rot_speed = -self.spawn_rot_speed -- меняем направление вращения на обратное
	end

	-- КОРРЕКЦИЯ ПОВОРОТА: если смотрим влево, зеркалим угол вращения или разворачиваем на 180 градусов
	local final_angle = self.spawn_angle
	if self.look_dir == -1 then
		-- Переворачиваем угол маятника зеркально для левой стороны
		final_angle = -self.spawn_angle + math.pi
	end

	-- Вращаем точку вокруг оси Z через кватернион с учетом направления взгляда
	go.set_rotation(vmath.quat_rotation_z(final_angle), "spawn_point")
end

function on_input(self, action_id, action)
	-- Локальная переменная для ID точки спавна, чтобы не ошибиться в имени
	local spawn_id = "spawn_point"

	-- Безопасно берем локальный вектор позиции точки спавна
	local pos = go.get_position(spawn_id)

	if action_id == hash("key-left") then
		self.dir_x = -1
		self.look_dir = -1 -- Запоминаем, что повернулись влево

		-- Отзеркалили картинку персонажа (использован ваш правильный ID)
		sprite.set_hflip("sprite_holder#player_sprite", true)

		-- Если она всё еще справа (больше нуля), перетаскиваем её налево
		if pos.x > 0 then
			pos.x = -25 --при повороте влево, точка будет смещаться на 80 пикселей налево
			go.set_position(pos, spawn_id)
		end

	elseif action_id == hash("key-right") then
		self.dir_x = 1
		self.look_dir = 1 -- Запоминаем, что повернулись вправо

		-- Вернули картинку персонажа в норму
		sprite.set_hflip("sprite_holder#player_sprite", false)

		-- Если она слева (меньше нуля), перетаскиваем её обратно направо
		if pos.x < 0 then
			pos.x = 25 --при повороте влево, точка будет смещаться на 25 пикселей направо
			go.set_position(pos, spawn_id)
		end

	elseif action_id == hash("key-space") and action.pressed then
		if self.count_of_jump > 0 then
			local v = go.get("#player_collider", "linear_velocity")
			v.y = 500
			go.set("#player_collider", "linear_velocity", v)
			self.count_of_jump = self.count_of_jump - 1

			--Вызываем метод с анимацией игрока
			play_jump_animation()
		end
	end

	if action_id == hash("fire") and action.pressed then
		local spawn_pos = go.get_world_position("spawn_point") 
		local spawn_rot = go.get_world_rotation("spawn_point")  -- получаем поворот точки
		factory.create("#flight_knife_factory", spawn_pos, spawn_rot)
	end
end


function on_message(self, message_id, message, sender) --метод получения сообщения от движка

	if message_id == hash("collision_response") then --если сообщение от физики (текущий обьект с чем то столкнулся)
		-- Просто проверяем, с кем столкнулись
		self.count_of_jump = 1;
	end
end

--Функция, проигрывающая анимацию прыжка персонажа
function play_jump_animation()
	--меняем спрайт игрока на прыжок
	-- "sprite" — это id компонента спрайта на игровом объекте
	-- "new_anim_id" — имя (id) нового спрайта/анимации внутри нашего атласа игрока
	sprite.play_flipbook("sprite_holder#player_sprite", "PlayerJump")

	timer.delay(1, false, function()
		-- Этот код выполнится ровно через 1 секунду
		sprite.play_flipbook("sprite_holder#player_sprite", "Player")
	end)
end
